# ── Terraform outputs → paste here after: terraform apply ──────
# terraform output raspberry_access_key_id
# terraform output -raw raspberry_secret_access_key
# terraform output sqs_queue_url
# terraform output iot_endpoint

# ── Raspberry Pi (raspberry/.env) ─────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SQS_QUEUE_URL=
AWS_IOT_ENDPOINT=
MODEL_ARN=arn:aws:rekognition:us-east-1:097300397506:project/model-black-background/version/model-black-background.2026-03-27T22.38.32/1774669112670

# ── Frontend / Flask (Frontend/.env) ──────────────────────────
# Uses its own IAM user credentials (or the same key if you reuse)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=sigr-detection-bucket-2026
AWS_IOT_ENDPOINT=

# MySQL
MYSQLHOST=
MYSQLPORT=3306
MYSQL_DATABASE=
MYSQLUSER=
MYSQLPASSWORD=

PORT=5000
